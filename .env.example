# Copy to .env and fill in the blanks. Never commit .env.
# Settings in the "Required" block have no default: the app refuses to start
# without them. Keep this file in sync with app/core/config.py
# (tests/test_config.py checks that it is).

# --- Required ------------------------------------------------------------

# Local Compose Postgres, reached from WSL through host port 5433.
# Production: Neon's DIRECT (non-pooled) connection string, with the prefix
# changed to postgresql+psycopg:// (psycopg 3; plain postgresql:// means psycopg2).
DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5433/triage

# Signs login tokens. At least 32 bytes; use a different value per environment.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Embeddings. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Generation. Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# --- Optional (defaults shown) ------------------------------------------

# Local Compose Redis. Production (Upstash) uses rediss:// (TLS).
REDIS_URL=redis://localhost:6379/0

# ENVIRONMENT=development
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# JWT_EXPIRY_MINUTES=60

# EMBEDDING_DIMENSIONS is deliberately not listed: it must match the
# vector(768) column, so changing it needs a migration, not an env var.
